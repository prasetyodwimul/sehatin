# SEHATIN backend environment example. Copy to .env; never commit real secrets.
APP_NAME=SEHATIN
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL + Psycopg 3 only.
DATABASE_URL=postgresql+psycopg://sehatin:sehatin@localhost:5432/sehatin

# Public request persistence remains minimized. Guided Nutrition persistence is
# created only after explicit Save consent and authenticated ownership.
PERSISTENCE_ENABLED=false
# Separate opt-in for storing personal Nutrition assessment fields from unauthenticated users.
# Keep false unless a reviewed consent/retention policy explicitly requires it.
PERSIST_ANONYMOUS_NUTRITION_PERSONAL_DATA=false
# Keep public Health Checker raw claim text off by default.
PERSIST_HEALTH_CLAIM_TEXT=false

# demo | database | auto
EVIDENCE_PROVIDER=auto
BLOOD_PROVIDER=auto

RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=65536

# Guided Nutrition daily window. Default: each day closes at 00:00 Asia/Jakarta and the next day opens.
NUTRITION_DAY_SCHEDULE=midnight
NUTRITION_TIMEZONE=Asia/Jakarta
NUTRITION_DAY_INTERVAL_SECONDS=86400

# Development/testing only: to simulate a day every 60 seconds, use:
# NUTRITION_DAY_SCHEDULE=interval
# NUTRITION_DAY_INTERVAL_SECONDS=60

# Controlled authentication for saved Guided Nutrition programs only.
# Generate a long random value before production deployment.
AUTH_PEPPER=change-this-to-a-long-random-secret
AUTH_SESSION_MINUTES=480
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10

# Health Checker
HEALTH_LIVE_RETRIEVAL_ENABLED=false
HEALTH_LIVE_MAX_RESULTS=3
HEALTH_FETCH_TIMEOUT_SECONDS=6
HEALTH_URL_MAX_BYTES=1500000
HEALTH_CHECKER_RATE_LIMIT_PER_MINUTE=30
HEALTH_CHECKER_MAX_CONCURRENT=4
